{
  "name": "@chxchx/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start --port 8082",
    "android": "npx expo start --android --port 8082",
    "ios": "npx expo start --ios --port 8082",
    "native:android": "npx expo run:android --port 8082",
    "native:ios": "npx expo run:ios --port 8082",
    "native:prebuild": "npx expo prebuild",
    "web": "npx expo start --web",
    "svgr:svg": "svgr --native assets/svg --out-dir components/icons --ext tsx --no-svgo"
  },
