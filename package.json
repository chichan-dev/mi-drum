{
  "name": "chxchx-dj-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "mobile:android": "npm run android --workspace=apps/mobile",
    "mobile:ios": "npm run ios --workspace=apps/mobile",
    "mobile:native:android": "npm run native:android --workspace=apps/mobile",
    "mobile:native:ios": "npm run native:ios --workspace=apps/mobile",
    "mobile:native:prebuild": "npm run native:prebuild --workspace=apps/mobile",
    "api": "npm run dev --workspace=apps/api",
    "api:build": "npm run build --workspace=apps/api"
  }
}
